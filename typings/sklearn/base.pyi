from typing import Any, TypeVar

_E = TypeVar("_E")

class BaseEstimator:
    def get_params(self, deep: bool = ...) -> dict[str, Any]: ...
    def set_params(self: _E, **params: Any) -> _E: ...

class TransformerMixin:
    def fit_transform(self, X: Any, y: Any = ..., **fit_params: Any) -> Any: ...
    def set_output(self: _E, *, transform: Any = ...) -> _E: ...

def clone(estimator: _E, *, safe: bool = ...) -> _E: ...
